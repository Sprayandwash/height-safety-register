{
  "name": "spray-wash-operations",
  "private": true,
  "version": "0.0.0",
  "description": "Local regression and browser-test tooling for Spray & Wash Operations.",
  "scripts": {
    "test:regression": "node --test tests/regression/*.test.cjs",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:ui:report": "playwright show-report",
    "test:staging:preflight": "playwright test --config=playwright.staging.config.cjs",
    "test:staging:vehicle-review": "playwright test --config=playwright.staging.review.config.cjs",
    "test:staging:maintenance-review": "playwright test --config=playwright.staging.maintenance.review.config.cjs",
    "test:staging:height-review": "playwright test --config=playwright.staging.height.review.config.cjs",
    "test:staging:height-readonly-security": "playwright test --config=playwright.staging.height.readonly-security.config.cjs",
    "test:staging:height-fixture": "playwright test --config=playwright.staging.height.fixture.config.cjs",
    "test:staging:preloaded-claim": "playwright test --config=playwright.staging.preloaded-claim.config.cjs",
    "test:staging:admin-readonly": "playwright test --config=playwright.staging.admin.readonly.config.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "http-server": "^14.1.1"
  }
}
